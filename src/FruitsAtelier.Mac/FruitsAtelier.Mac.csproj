<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../assets/icons/discussion/*" Link="assets/icons/discussion/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/setup/*.ogg;../../assets/setup/*.png" Link="assets/setup/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="FruitsAtelier.Mac.Tests" />
    <InternalsVisibleTo Include="FruitsAtelier.App.Tests" />
    <Content Include="../../assets/branding/fad-file.*;../../assets/branding/faz-file.*;../../assets/branding/fpt-file.*;../../assets/branding/app-icon.*;../../assets/branding/mark.png" Link="assets/branding/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../FruitsAtelier.Core/Workspace/Licenses/*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../FruitsAtelier.Core/FruitsAtelier.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <!-- Use the security backport for Avalonia's transitive D-Bus dependency. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <PackageReference Include="FFmpeg.AutoGen" Version="4.3.0.1" />
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2025.806.0-nativelibs" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <Content Include="$(Pkgppy_osu_Framework_NativeLibs)/runtimes/osx/native/libav*.dylib;$(Pkgppy_osu_Framework_NativeLibs)/runtimes/osx/native/libswscale*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../FruitsAtelier.App/Media/*.cs" Link="Media/%(Filename)%(Extension)" />
    <Content Include="../FruitsAtelier.App/Media/Licenses/*.txt" Link="Media/Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../FruitsAtelier.App/Editor/*.cs" Link="Editor/%(Filename)%(Extension)" />
    <Compile Include="../FruitsAtelier.App/Skinning/CatchSkin.cs" Link="Skinning/CatchSkin.cs" />
    <Compile Include="../FruitsAtelier.App/Rendering/ICanvas.cs" Link="Rendering/ICanvas.cs" />
    <Compile Include="../FruitsAtelier.App/Rendering/ThumbnailCache.cs" Link="Rendering/ThumbnailCache.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/BeatmapArchive.cs" Link="Platform/BeatmapArchive.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/LibraryOperations.cs" Link="Platform/LibraryOperations.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/FazArchive.cs" Link="Platform/FazArchive.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/FadArchive.cs" Link="Platform/FadArchive.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/FazStaging.cs" Link="Platform/FazStaging.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/BeatmapResources.cs" Link="Platform/BeatmapResources.cs" />
    <Compile Include="../FruitsAtelier.App/Platform/SkinArchive.cs" Link="Platform/SkinArchive.cs" />
    <Content Include="../../assets/icons/tools/*.png" Link="assets/icons/tools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/icons/library/*.png" Link="assets/icons/library/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/icons/osu/*" Link="assets/icons/osu/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Licenses/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../FruitsAtelier.App/Audio/Licenses/NVorbis.txt" Link="Licenses/NVorbis.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../FruitsAtelier.Core/Conversion/LICENCE*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(IntermediateOutputPath)native/libFruitsAtelierAudio.dylib" Link="libFruitsAtelierAudio.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMacAudio" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Inputs="Native/Audio.m;Native/Hitsounds.m;Native/Browser.m;Native/Trash.m" Outputs="$(IntermediateOutputPath)native/libFruitsAtelierAudio.dylib">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="xcrun clang -dynamiclib -fobjc-arc -O2 -mmacosx-version-min=12.0 -framework Foundation -framework AVFoundation -framework AppKit -framework WebKit &quot;$(MSBuildProjectDirectory)/Native/Audio.m&quot; &quot;$(MSBuildProjectDirectory)/Native/Hitsounds.m&quot; &quot;$(MSBuildProjectDirectory)/Native/Browser.m&quot; &quot;$(MSBuildProjectDirectory)/Native/Trash.m&quot; -o &quot;$(IntermediateOutputPath)native/libFruitsAtelierAudio.dylib&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="../../assets/icons/assist/*.png" Link="assets/icons/assist/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/icons/bookmarks/*.png" Link="assets/icons/bookmarks/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/ui/timing/*.png" Link="assets/ui/timing/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/ui/catch/*" Link="assets/ui/catch/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
