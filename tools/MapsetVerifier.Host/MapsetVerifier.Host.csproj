<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FruitsAtelier.MapsetVerifier</AssemblyName>
    <NuGetLockFilePath>packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MapsetVerifierSourceRoot)/MapsetVerifier.Checks/MapsetVerifier.Checks.csproj" />
  </ItemGroup>
  <Target Name="PruneUnusedGameResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)', '^(osu\.Game\.Resources\.dll|(lib)?SDL[23]\.(dll|so|dylib.*)|libveldrid-spirv\.(dll|so|dylib)|(lib)?(avcodec|avformat|avutil|avdevice|avfilter|swscale|swresample)[-.].*)$'))" />
    </ItemGroup>
  </Target>
</Project>
